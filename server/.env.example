# Copy this file to ".env" and fill in your own values.

# Port the server listens on
PORT=4000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/wavechat
# Atlas (free tier): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wavechat
MONGO_URI=mongodb://127.0.0.1:27017/wavechat

# Secret used to sign JWT login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# How long a login token stays valid
JWT_EXPIRES_IN=30d

# Public base URL of THIS server (used to build absolute media URLs).
# On Render it looks like https://wavechat-server.onrender.com
PUBLIC_URL=http://localhost:4000

# Comma-separated list of allowed browser origins. Use * to allow all.
CORS_ORIGIN=*

# Optional TURN server for reliable voice/video calls behind strict NATs.
# Leave blank to use public STUN only (fine for testing, may fail on some networks).
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
