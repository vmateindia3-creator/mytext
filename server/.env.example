# Copy this file to ".env" and fill in your own values.

# Port the server listens on
PORT=4000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/mytext
# Atlas (free tier): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mytext
MONGO_URI=mongodb://127.0.0.1:27017/mytext

# Secret used to sign JWT login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# How long a login token stays valid
JWT_EXPIRES_IN=30d

# Public base URL of THIS server (used to build absolute media URLs).
# On Render it looks like https://mytext-server.onrender.com
PUBLIC_URL=http://localhost:4000

# Comma-separated list of allowed browser origins. Use * to allow all.
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# local | s3 | cloudinary
STORAGE_DRIVER=local

# --- Amazon S3 (or any S3-compatible service: Cloudflare R2, Backblaze B2, MinIO)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: custom endpoint for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Optional: public base URL for reading objects, e.g. https://cdn.example.com
S3_PUBLIC_URL=

# --- Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Push notifications (Firebase Cloud Messaging)
# ---------------------------------------------------------------------------
# Provide ONE of these. If neither is set, push is simply disabled.
# The service-account JSON as a single-line string:
FIREBASE_SERVICE_ACCOUNT=
# ...or a path to the downloaded service-account .json file:
FIREBASE_SERVICE_ACCOUNT_PATH=

# ---------------------------------------------------------------------------
# Phone login (SMS one-time passwords)
# ---------------------------------------------------------------------------
# console | twilio | msg91 | fast2sms
#   console = does NOT send an SMS. It prints the code in the server log and
#             hands it back to the app so you can test the whole flow for free.
SMS_DRIVER=console

# Keep true while testing so the app can show the code. Set to false in
# production once a real SMS provider is configured.
OTP_DEV_MODE=true

# --- Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- MSG91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MYTEXT
MSG91_TEMPLATE_ID=

# --- Fast2SMS
FAST2SMS_API_KEY=

# ---------------------------------------------------------------------------
# Voice / video calls
# ---------------------------------------------------------------------------
# Optional TURN server for reliable calls behind strict NATs.
# Leave blank to use public STUN + a free shared TURN relay (good for testing).
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# When TURN_URL is empty, a free public TURN relay is added so calls can get
# through mobile networks. Set to false once you have your own TURN server.
PUBLIC_TURN_ENABLED=true
